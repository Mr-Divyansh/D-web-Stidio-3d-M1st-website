<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <!-- (release) the 404 — Apache's ErrorDocument serves it at any missing path: every URL here is absolute -->
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#02050c" />
    <title>Page not found — Samana Studio</title>
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16.png?v=2"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=2"
    />
    <link
      rel="preload"
      href="/fonts/InterSamana-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style>
      @font-face {
        font-family: "Inter";
        src: url("/fonts/InterSamana-Variable.woff2") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Geist Mono";
        src: url("/fonts/geist-mono-300-500.woff2") format("woff2");
        font-weight: 300 500;
        font-style: normal;
        font-display: swap;
      }
      :root {
        /* the site's water (src/style.css: --water-top / --water-bot) and the legal pages' ink */
        --water-top: #02050c;
        --water-bot: #010205;
        --ink: #e8f0ff;
        --body: #b9c6da;
        --muted: #8a98b0;
        --accent: #9fd0ff;
        --line: rgba(159, 208, 255, 0.22);
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      html {
        min-height: 100%;
        background: linear-gradient(
            180deg,
            var(--water-top) 0%,
            var(--water-bot) 100%
          )
          fixed var(--water-bot);
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 24px 16px;
        color: var(--body);
        font:
          400 16px/1.6 "Inter",
          system-ui,
          -apple-system,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(
          120% 80% at 50% -10%,
          rgba(159, 208, 255, 0.07),
          transparent 58%
        );
      }
      main {
        position: relative;
        max-width: 30rem;
        text-align: center;
      }
      .mark {
        display: inline-block;
        color: var(--ink);
        font-weight: 700;
        font-size: 1.35rem;
        letter-spacing: -0.02em;
        text-decoration: none;
      }
      .mark sup {
        font-size: 0.5em;
        font-weight: 500;
        margin-left: 0.08em;
      }
      .code {
        margin: 2.4rem 0 0.6rem;
        font:
          400 0.8rem/1 "Geist Mono",
          ui-monospace,
          monospace;
        letter-spacing: 0.24em;
        color: var(--muted);
      }
      h1 {
        margin: 0;
        color: var(--ink);
        font-weight: 600;
        font-size: clamp(1.9rem, 6vw, 2.6rem);
        line-height: 1.12;
        letter-spacing: -0.02em;
      }
      .es {
        margin: 0.6rem 0 2.2rem;
        color: var(--muted);
      }
      .home {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        min-height: 48px;
        padding: 0 1.4rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--ink);
        font-weight: 500;
        text-decoration: none;
        transition:
          border-color 0.2s,
          background-color 0.2s;
      }
      .home:hover {
        border-color: var(--accent);
        background-color: rgba(159, 208, 255, 0.06);
      }
      .home:focus-visible,
      .mark:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }
    </style>
  </head>
  <body>
    <main>
      <a class="mark" href="/" aria-label="Samana — home"
        >Samana<sup aria-hidden="true">®</sup></a
      >
      <p class="code">404</p>
      <h1>This page isn’t here.</h1>
      <p class="es" lang="es">Esta página no existe.</p>
      <a class="home" href="/"
        ><span aria-hidden="true">←</span> Back to Samana</a
      >
    </main>
  </body>
</html>